{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student or Komting profile bound to Firebase Auth UID, NIM, classId, role, and account status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nim": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "avatarInitials": { "type": "string", "minLength": 1, "maxLength": 4 },
        "activeClassId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "mahasiswa"] },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "nim", "name", "email", "avatarInitials", "activeClassId", "role", "status", "createdAt", "updatedAt"]
    },
    "ClassDirectoryEntry": {
      "title": "ClassDirectoryEntry",
      "description": "Class code lookup record allowing students with an activation code to locate their class.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "semester": { "type": "string", "minLength": 1, "maxLength": 64 },
        "academicYear": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["classId", "code", "name", "semester", "academicYear", "createdBy"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Class workspace container holding courses, schedules, tasks, groups, and announcements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "semester": { "type": "string", "minLength": 1, "maxLength": 64 },
        "academicYear": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "semester", "academicYear", "createdBy", "createdAt", "updatedAt"]
    },
    "ClassMember": {
      "title": "ClassMember",
      "description": "Class-scoped membership, RBAC role, and account status without sensitive PII.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nim": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "avatarInitials": { "type": "string", "minLength": 1, "maxLength": 4 },
        "role": { "type": "string", "enum": ["admin", "mahasiswa"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "classId", "nim", "name", "avatarInitials", "role", "title", "status", "joinedAt", "updatedAt"]
    },
    "ClassRosterEntry": {
      "title": "ClassRosterEntry",
      "description": "Komting-provisioned student roster entry controlling allowed NIMs, roles, and SHA-256 activation codes.",
      "type": "object",
      "properties": {
        "nim": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nimKey": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_\\-]+$" },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "mahasiswa"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "active", "disabled"] },
        "activationCodeHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "claimedByUid": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nim", "nimKey", "classId", "name", "role", "title", "status", "activationCodeHash", "createdBy", "createdAt", "updatedAt"]
    },
    "ActivationClaim": {
      "title": "ActivationClaim",
      "description": "Atomic activation proof verifying a student knows the Komting-issued activation code for their NIM.",
      "type": "object",
      "properties": {
        "nimKey": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_\\-]+$" },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "codeHash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "claimedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nimKey", "classId", "uid", "codeHash", "claimedAt"]
    },
    "ActivationTicket": {
      "title": "ActivationTicket",
      "description": "Unlisted capability-keyed ticket (keyed by SHA-256 activation hash) providing exact assigned role/name during activation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 64, "maxLength": 64 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nim": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nimKey": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "mahasiswa"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "active", "disabled"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "nim", "nimKey", "name", "role", "title", "status", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Course metadata within a class.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "lecturer": { "type": "string", "minLength": 1, "maxLength": 150 },
        "credits": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "code", "name", "lecturer", "credits", "createdAt", "updatedAt"]
    },
    "CourseCollection": {
      "title": "CourseCollection",
      "description": "Primary submission link inherited by tasks and group tasks for a course.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 150 },
        "url": { "type": "string", "minLength": 1, "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "label", "url", "updatedAt"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Weekly recurring class schedule entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dayOfWeek": { "type": "integer" },
        "startTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "endTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "room": { "type": "string", "minLength": 1, "maxLength": 120 },
        "effectiveFrom": { "type": "string", "maxLength": 10 },
        "effectiveUntil": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "courseId", "dayOfWeek", "startTime", "endTime", "room", "createdAt", "updatedAt"]
    },
    "ScheduleException": {
      "title": "ScheduleException",
      "description": "Single-date modification or cancellation overriding a recurring schedule.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scheduleId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "type": { "type": "string", "enum": ["modified", "cancelled"] },
        "overrideCourseId": { "type": "string", "maxLength": 128 },
        "overrideStartTime": { "type": "string", "maxLength": 5 },
        "overrideEndTime": { "type": "string", "maxLength": 5 },
        "overrideRoom": { "type": "string", "maxLength": 120 },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "scheduleId", "date", "type", "createdAt", "updatedAt"]
    },
    "IndividualTask": {
      "title": "IndividualTask",
      "description": "Class-wide individual assignment managed by Komting/Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "descriptionHtml": { "type": "string", "maxLength": 12000 },
        "deadline": { "type": "string", "maxLength": 64 },
        "overrideCollectionLabel": { "type": "string", "maxLength": 150 },
        "overrideCollectionUrl": { "type": "string", "maxLength": 500 },
        "version": { "type": "integer" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "courseId", "title", "descriptionHtml", "version", "createdBy", "createdAt", "updatedAt"]
    },
    "TaskCompletion": {
      "title": "TaskCompletion",
      "description": "Personal completion state and private note for an individual task.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 260 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "taskVersion": { "type": "integer" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string", "maxLength": 64 },
        "note": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "taskId", "userId", "taskVersion", "completed", "updatedAt"]
    },
    "GroupActivity": {
      "title": "GroupActivity",
      "description": "Group formation activity created by Komting with locked participant and group counts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "totalParticipants": { "type": "integer" },
        "groupCount": { "type": "integer" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "courseId", "name", "totalParticipants", "groupCount", "createdBy", "createdAt"]
    },
    "GroupItem": {
      "title": "GroupItem",
      "description": "Individual group within a group formation activity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "activityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groupNumber": { "type": "integer" },
        "isFinal": { "type": "boolean" },
        "finalizedAt": { "type": "string", "maxLength": 64 },
        "finalizedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "classId", "activityId", "groupNumber", "isFinal"]
    },
    "GroupMember": {
      "title": "GroupMember",
      "description": "Internal student or external member enrolled in a group.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 260 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "activityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nim": { "type": "string", "maxLength": 32 },
        "isExternal": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "activityId", "groupId", "fullName", "isExternal", "joinedAt"]
    },
    "GroupTask": {
      "title": "GroupTask",
      "description": "Group assignment attached to a group activity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "activityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "descriptionHtml": { "type": "string", "maxLength": 12000 },
        "deadline": { "type": "string", "maxLength": 64 },
        "overrideCollectionLabel": { "type": "string", "maxLength": 150 },
        "overrideCollectionUrl": { "type": "string", "maxLength": 500 },
        "version": { "type": "integer" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "activityId", "title", "descriptionHtml", "version", "createdBy", "createdAt", "updatedAt"]
    },
    "GroupTaskCompletion": {
      "title": "GroupTaskCompletion",
      "description": "Per-group completion state for a group task.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 260 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groupTaskId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "groupId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "taskVersion": { "type": "integer" },
        "completed": { "type": "boolean" },
        "completedBy": { "type": "string", "maxLength": 128 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "groupTaskId", "groupId", "taskVersion", "completed", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Class or course-specific announcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "title", "content", "authorId", "publishedAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped internal notification for tasks and announcements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["task_new", "task_updated", "announcement_new"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 },
        "targetSection": { "type": "string", "enum": ["dashboard", "jadwal", "tugas", "kelompok", "pengumuman"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classId", "userId", "type", "title", "message", "targetSection", "targetId", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile with internal NIM-mapped auth email, role, and status."
    },
    "/classDirectory/{classCode}": {
      "schema": { "$ref": "#/entities/ClassDirectoryEntry" },
      "description": "Class code lookup directory for activating a provisioned account."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassRoom" },
      "description": "Class workspace root document."
    },
    "/classes/{classId}/roster/{nimKey}": {
      "schema": { "$ref": "#/entities/ClassRosterEntry" },
      "description": "Komting-managed roster controlling allowed NIMs, assigned roles, and activation hashes."
    },
    "/classes/{classId}/activationClaims/{nimKey}": {
      "schema": { "$ref": "#/entities/ActivationClaim" },
      "description": "Atomic activation proof created when a provisioned student activates their NIM account."
    },
    "/classes/{classId}/activationTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/ActivationTicket" },
      "description": "Hash-keyed activation ticket allowing provisioned students to retrieve assigned name and role without listing the roster."
    },
    "/classes/{classId}/members/{userId}": {
      "schema": { "$ref": "#/entities/ClassMember" },
      "description": "Class membership, RBAC role, and active/disabled status per user."
    },
    "/classes/{classId}/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Courses taught in the class."
    },
    "/classes/{classId}/courseCollections/{courseId}": {
      "schema": { "$ref": "#/entities/CourseCollection" },
      "description": "Primary collection link per course."
    },
    "/classes/{classId}/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "Weekly recurring schedules for the class."
    },
    "/classes/{classId}/scheduleExceptions/{exceptionId}": {
      "schema": { "$ref": "#/entities/ScheduleException" },
      "description": "Specific date modifications or cancellations."
    },
    "/classes/{classId}/individualTasks/{taskId}": {
      "schema": { "$ref": "#/entities/IndividualTask" },
      "description": "Individual class-wide assignments."
    },
    "/classes/{classId}/taskCompletions/{completionId}": {
      "schema": { "$ref": "#/entities/TaskCompletion" },
      "description": "Personal task completion state and note per student."
    },
    "/classes/{classId}/groupActivities/{activityId}": {
      "schema": { "$ref": "#/entities/GroupActivity" },
      "description": "Group formation activities."
    },
    "/classes/{classId}/groups/{groupId}": {
      "schema": { "$ref": "#/entities/GroupItem" },
      "description": "Groups within group activities."
    },
    "/classes/{classId}/groupMembers/{memberId}": {
      "schema": { "$ref": "#/entities/GroupMember" },
      "description": "Internal and external members of each group."
    },
    "/classes/{classId}/groupTasks/{groupTaskId}": {
      "schema": { "$ref": "#/entities/GroupTask" },
      "description": "Tasks assigned to groups in an activity."
    },
    "/classes/{classId}/groupTaskCompletions/{completionId}": {
      "schema": { "$ref": "#/entities/GroupTaskCompletion" },
      "description": "Per-group completion status for group tasks."
    },
    "/classes/{classId}/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Class announcements."
    },
    "/classes/{classId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped notifications."
    }
  }
}
