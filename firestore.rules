rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Global Hardened Helpers
    // ------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNim(nim) {
      return nim is string && nim.size() >= 3 && nim.size() <= 32 && nim.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNimKey(nimKey) {
      return nimKey is string && nimKey.size() >= 3 && nimKey.size() <= 32 && nimKey.matches('^[a-z0-9_\\-]+$');
    }

    function isValidSha256Hex(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function memberDocPath(classId, userId) {
      return /databases/$(database)/documents/classes/$(classId)/members/$(userId);
    }

    function rosterDocPath(classId, nimKey) {
      return /databases/$(database)/documents/classes/$(classId)/roster/$(nimKey);
    }

    function claimDocPath(classId, nimKey) {
      return /databases/$(database)/documents/classes/$(classId)/activationClaims/$(nimKey);
    }

    function isClassMember(classId) {
      return isSignedIn()
        && exists(memberDocPath(classId, request.auth.uid))
        && get(memberDocPath(classId, request.auth.uid)).data.status == 'active';
    }

    function isClassAdmin(classId) {
      return isClassMember(classId)
        && get(memberDocPath(classId, request.auth.uid)).data.role == 'admin';
    }

    function isClassCreatorAfter(classId) {
      return isSignedIn()
        && existsAfter(/databases/$(database)/documents/classes/$(classId))
        && getAfter(/databases/$(database)/documents/classes/$(classId)).data.createdBy == request.auth.uid;
    }

    function isValidRole(role) {
      return role in ['admin', 'mahasiswa'];
    }

    function isValidAccountStatus(status) {
      return status in ['active', 'disabled'];
    }

    function isValidRosterStatus(status) {
      return status in ['pending', 'active', 'disabled'];
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    // ------------------------------------------------------------------
    // Validation Blueprints
    // ------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'nim', 'name', 'email', 'avatarInitials', 'activeClassId', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'nim', 'name', 'email', 'avatarInitials', 'avatarId', 'activeClassId', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && isValidNim(data.nim)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.avatarInitials is string && data.avatarInitials.size() >= 1 && data.avatarInitials.size() <= 4
        && isValidId(data.activeClassId)
        && isValidRole(data.role)
        && isValidAccountStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassDirectoryEntry(data, classCode) {
      return data.keys().hasAll(['classId', 'code', 'name', 'semester', 'academicYear', 'createdBy'])
        && data.keys().hasOnly(['classId', 'code', 'name', 'semester', 'academicYear', 'createdBy'])
        && isValidId(data.classId)
        && data.code is string && data.code == classCode && data.code.size() >= 2 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 64
        && data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 32
        && isValidId(data.createdBy);
    }

    function isValidClassRoom(data, classId) {
      return data.keys().hasAll(['id', 'code', 'name', 'semester', 'academicYear', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'code', 'name', 'semester', 'academicYear', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id == classId && isValidId(data.id)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 64
        && data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 32
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassMember(data, classId, userId) {
      return data.keys().hasAll(['userId', 'classId', 'nim', 'name', 'avatarInitials', 'role', 'title', 'status', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'classId', 'nim', 'name', 'avatarInitials', 'role', 'title', 'status', 'joinedAt', 'updatedAt'])
        && data.userId == userId && isValidId(data.userId)
        && data.classId == classId && isValidId(data.classId)
        && isValidNim(data.nim)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.avatarInitials is string && data.avatarInitials.size() >= 1 && data.avatarInitials.size() <= 4
        && isValidOptionalString(data, 'avatarId', 32)
        && isValidRole(data.role)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 64
        && isValidAccountStatus(data.status)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRosterEntry(data, classId, nimKey) {
      return data.keys().hasAll(['nim', 'nimKey', 'classId', 'name', 'role', 'title', 'status', 'activationCodeHash', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nim', 'nimKey', 'classId', 'name', 'role', 'title', 'status', 'activationCodeHash', 'claimedByUid', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidNim(data.nim)
        && data.nim.lower() == nimKey
        && isValidNimKey(data.nimKey)
        && data.nimKey == nimKey
        && data.classId == classId && isValidId(data.classId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidRole(data.role)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 64
        && isValidRosterStatus(data.status)
        && isValidSha256Hex(data.activationCodeHash)
        && isValidOptionalString(data, 'claimedByUid', 128)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivationClaim(data, classId, nimKey) {
      return data.keys().hasAll(['nimKey', 'classId', 'uid', 'codeHash', 'claimedAt'])
        && data.keys().hasOnly(['nimKey', 'classId', 'uid', 'codeHash', 'claimedAt'])
        && isValidNimKey(data.nimKey)
        && data.nimKey == nimKey
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.uid)
        && isValidSha256Hex(data.codeHash)
        && data.claimedAt is timestamp;
    }

    function isValidActivationTicket(data, classId, ticketId) {
      return data.keys().hasAll(['id', 'classId', 'nim', 'nimKey', 'name', 'role', 'title', 'status', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'nim', 'nimKey', 'name', 'role', 'title', 'status', 'updatedAt'])
        && isValidSha256Hex(data.id)
        && data.id == ticketId
        && data.classId == classId && isValidId(data.classId)
        && isValidNim(data.nim)
        && isValidNimKey(data.nimKey)
        && data.nim.lower() == data.nimKey
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidRole(data.role)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 64
        && isValidRosterStatus(data.status)
        && data.updatedAt is timestamp;
    }

    function isValidCourse(data, classId, courseId) {
      return data.keys().hasAll(['id', 'classId', 'code', 'name', 'lecturer', 'credits', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'code', 'name', 'lecturer', 'credits', 'createdAt', 'updatedAt'])
        && data.id == courseId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.lecturer is string && data.lecturer.size() >= 1 && data.lecturer.size() <= 150
        && data.credits is int && data.credits >= 1 && data.credits <= 12
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseCollection(data, courseId) {
      return data.keys().hasAll(['id', 'courseId', 'label', 'url', 'updatedAt'])
        && data.keys().hasOnly(['id', 'courseId', 'label', 'url', 'updatedAt'])
        && isValidId(data.id)
        && data.courseId == courseId && isValidId(data.courseId)
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 150
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data, classId, scheduleId) {
      return data.keys().hasAll(['id', 'classId', 'courseId', 'dayOfWeek', 'startTime', 'endTime', 'room', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'courseId', 'dayOfWeek', 'startTime', 'endTime', 'room', 'effectiveFrom', 'effectiveUntil', 'createdAt', 'updatedAt'])
        && data.id == scheduleId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.courseId)
        && data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7
        && data.startTime is string && data.startTime.matches('^[0-2][0-9]:[0-5][0-9]$')
        && data.endTime is string && data.endTime.matches('^[0-2][0-9]:[0-5][0-9]$')
        && data.room is string && data.room.size() >= 1 && data.room.size() <= 120
        && isValidOptionalString(data, 'effectiveFrom', 10)
        && isValidOptionalString(data, 'effectiveUntil', 10)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScheduleException(data, classId, exceptionId) {
      return data.keys().hasAll(['id', 'classId', 'scheduleId', 'date', 'type', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'scheduleId', 'date', 'type', 'overrideCourseId', 'overrideStartTime', 'overrideEndTime', 'overrideRoom', 'reason', 'createdAt', 'updatedAt'])
        && data.id == exceptionId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.scheduleId)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.type in ['modified', 'cancelled']
        && isValidOptionalString(data, 'overrideCourseId', 128)
        && isValidOptionalString(data, 'overrideStartTime', 5)
        && isValidOptionalString(data, 'overrideEndTime', 5)
        && isValidOptionalString(data, 'overrideRoom', 120)
        && isValidOptionalString(data, 'reason', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIndividualTask(data, classId, taskId) {
      return data.keys().hasAll(['id', 'classId', 'courseId', 'title', 'descriptionHtml', 'version', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'courseId', 'title', 'descriptionHtml', 'deadline', 'overrideCollectionLabel', 'overrideCollectionUrl', 'version', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id == taskId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.courseId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.descriptionHtml is string && data.descriptionHtml.size() <= 12000
        && isValidOptionalString(data, 'deadline', 64)
        && isValidOptionalString(data, 'overrideCollectionLabel', 150)
        && isValidOptionalString(data, 'overrideCollectionUrl', 500)
        && data.version is int && data.version >= 1
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTaskCompletion(data, classId, completionId) {
      return data.keys().hasAll(['id', 'classId', 'taskId', 'userId', 'taskVersion', 'completed', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'taskId', 'userId', 'taskVersion', 'completed', 'completedAt', 'note', 'updatedAt'])
        && data.id == completionId && data.id is string && data.id.size() >= 1 && data.id.size() <= 260
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.taskId)
        && isValidId(data.userId)
        && data.taskVersion is int && data.taskVersion >= 1
        && data.completed is bool
        && isValidOptionalString(data, 'completedAt', 64)
        && isValidOptionalString(data, 'note', 2000)
        && data.updatedAt is timestamp;
    }

    function isValidGroupActivity(data, classId, activityId) {
      return data.keys().hasAll(['id', 'classId', 'courseId', 'name', 'totalParticipants', 'groupCount', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'classId', 'courseId', 'name', 'totalParticipants', 'groupCount', 'createdBy', 'createdAt'])
        && data.id == activityId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.courseId)
        && data.name is string && data.name.size() <= 150
        && data.totalParticipants is int && data.totalParticipants >= 1 && data.totalParticipants <= 500
        && data.groupCount is int && data.groupCount >= 1 && data.groupCount <= data.totalParticipants
        && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidGroupItem(data, classId, groupId) {
      return data.keys().hasAll(['id', 'classId', 'activityId', 'groupNumber', 'isFinal'])
        && data.keys().hasOnly(['id', 'classId', 'activityId', 'groupNumber', 'isFinal', 'finalizedAt', 'finalizedBy'])
        && data.id == groupId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.activityId)
        && data.groupNumber is int && data.groupNumber >= 1 && data.groupNumber <= 200
        && data.isFinal is bool
        && isValidOptionalString(data, 'finalizedAt', 64)
        && isValidOptionalString(data, 'finalizedBy', 128);
    }

    function isValidGroupMember(data, classId, memberId) {
      return data.keys().hasAll(['id', 'classId', 'activityId', 'groupId', 'fullName', 'isExternal', 'joinedAt'])
        && data.keys().hasOnly(['id', 'classId', 'activityId', 'groupId', 'userId', 'fullName', 'nim', 'isExternal', 'joinedAt'])
        && data.id == memberId && data.id is string && data.id.size() >= 1 && data.id.size() <= 260
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.activityId)
        && isValidId(data.groupId)
        && isValidOptionalString(data, 'userId', 128)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && isValidOptionalString(data, 'nim', 32)
        && data.isExternal is bool
        && data.joinedAt is timestamp;
    }

    function isValidGroupTask(data, classId, groupTaskId) {
      return data.keys().hasAll(['id', 'classId', 'activityId', 'title', 'descriptionHtml', 'version', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'activityId', 'title', 'descriptionHtml', 'deadline', 'overrideCollectionLabel', 'overrideCollectionUrl', 'version', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id == groupTaskId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.activityId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.descriptionHtml is string && data.descriptionHtml.size() <= 12000
        && isValidOptionalString(data, 'deadline', 64)
        && isValidOptionalString(data, 'overrideCollectionLabel', 150)
        && isValidOptionalString(data, 'overrideCollectionUrl', 500)
        && data.version is int && data.version >= 1
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGroupTaskCompletion(data, classId, completionId) {
      return data.keys().hasAll(['id', 'classId', 'groupTaskId', 'groupId', 'taskVersion', 'completed', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'groupTaskId', 'groupId', 'taskVersion', 'completed', 'completedBy', 'completedAt', 'updatedAt'])
        && data.id == completionId && data.id is string && data.id.size() >= 1 && data.id.size() <= 260
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.groupTaskId)
        && isValidId(data.groupId)
        && data.taskVersion is int && data.taskVersion >= 1
        && data.completed is bool
        && isValidOptionalString(data, 'completedBy', 128)
        && isValidOptionalString(data, 'completedAt', 64)
        && data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data, classId, announcementId) {
      return data.keys().hasAll(['id', 'classId', 'title', 'content', 'authorId', 'publishedAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'classId', 'courseId', 'title', 'content', 'authorId', 'publishedAt', 'updatedAt'])
        && data.id == announcementId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidOptionalString(data, 'courseId', 128)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 8000
        && isValidId(data.authorId)
        && data.publishedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data, classId, notificationId) {
      return data.keys().hasAll(['id', 'classId', 'userId', 'type', 'title', 'message', 'targetSection', 'targetId', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['id', 'classId', 'userId', 'type', 'title', 'message', 'targetSection', 'targetId', 'isRead', 'createdAt'])
        && data.id == notificationId && isValidId(data.id)
        && data.classId == classId && isValidId(data.classId)
        && isValidId(data.userId)
        && data.type in ['task_new', 'task_updated', 'announcement_new']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 300
        && data.targetSection in ['dashboard', 'jadwal', 'tugas', 'kelompok', 'pengumuman']
        && isValidId(data.targetId)
        && data.isRead is bool
        && data.createdAt is timestamp;
    }

    // ------------------------------------------------------------------
    // Connection test path (read-only ping)
    // ------------------------------------------------------------------
    match /test/connection {
      allow get: if isSignedIn();
    }

    // ------------------------------------------------------------------
    // Users (Private profile isolated to owner; role/status validated)
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().email == (incoming().nim.lower() + '@klik.internal')
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isClassCreatorAfter(incoming().activeClassId) && incoming().role == 'admin')
          || (
            existsAfter(claimDocPath(incoming().activeClassId, incoming().nim.lower()))
            && exists(rosterDocPath(incoming().activeClassId, incoming().nim.lower()))
            && incoming().role == get(rosterDocPath(incoming().activeClassId, incoming().nim.lower())).data.role
          )
        );
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().nim == existing().nim
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().status == existing().status
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarInitials', 'avatarId', 'activeClassId', 'updatedAt'])
        && (incoming().activeClassId == existing().activeClassId || isClassMember(incoming().activeClassId));
    }

    // ------------------------------------------------------------------
    // Class Directory (exact code lookup only, no list)
    // ------------------------------------------------------------------
    match /classDirectory/{classCode} {
      allow get: if isSignedIn() && classCode is string && classCode.size() >= 2 && classCode.size() <= 32;
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/classDirectory/$(classCode))
        && isValidClassDirectoryEntry(incoming(), classCode)
        && incoming().createdBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/classes/$(incoming().classId));
      allow update: if isSignedIn()
        && isValidClassDirectoryEntry(incoming(), classCode)
        && isClassAdmin(existing().classId)
        && incoming().classId == existing().classId
        && incoming().createdBy == existing().createdBy
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'semester', 'academicYear']);
    }

    // ------------------------------------------------------------------
    // Classes & Subcollections (Master Gate)
    // ------------------------------------------------------------------
    match /classes/{classId} {
      allow get: if isValidId(classId) && isClassMember(classId);
      allow create: if isValidId(classId)
        && isSignedIn()
        && !exists(/databases/$(database)/documents/classes/$(classId))
        && isValidClassRoom(incoming(), classId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/classDirectory/$(incoming().code));
      allow update: if isValidId(classId)
        && isClassAdmin(classId)
        && isValidClassRoom(incoming(), classId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'semester', 'academicYear', 'updatedAt']);

      // Komting-Provisioned Class Roster (strictly admin-readable)
      match /roster/{nimKey} {
        allow get: if isValidId(classId) && isValidNimKey(nimKey) && isClassAdmin(classId);
        allow list: if isValidId(classId) && isClassAdmin(classId);
        allow create: if isValidId(classId) && isValidNimKey(nimKey)
          && isValidRosterEntry(incoming(), classId, nimKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            (isClassAdmin(classId) && incoming().status == 'pending' && (!('claimedByUid' in incoming()) || incoming().claimedByUid == null))
            || (
              isClassCreatorAfter(classId)
              && incoming().createdBy == request.auth.uid
              && incoming().role == 'admin'
              && incoming().status == 'active'
              && incoming().claimedByUid == request.auth.uid
              && request.auth.token.email == (nimKey + '@klik.internal')
            )
          );
        allow update: if isValidId(classId) && isValidNimKey(nimKey)
          && isValidRosterEntry(incoming(), classId, nimKey)
          && incoming().nim == existing().nim
          && incoming().nimKey == existing().nimKey
          && incoming().classId == existing().classId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              isClassAdmin(classId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'title', 'status', 'activationCodeHash', 'claimedByUid', 'updatedAt'])
            )
            || (
              isSignedIn()
              && existing().status == 'pending'
              && (!('claimedByUid' in existing()) || existing().claimedByUid == null)
              && incoming().status == 'active'
              && incoming().claimedByUid == request.auth.uid
              && incoming().name == existing().name
              && incoming().role == existing().role
              && incoming().title == existing().title
              && incoming().activationCodeHash == existing().activationCodeHash
              && request.auth.token.email == (nimKey + '@klik.internal')
              && existsAfter(claimDocPath(classId, nimKey))
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'updatedAt'])
            )
          );
        allow delete: if isValidId(classId) && isValidNimKey(nimKey) && isClassAdmin(classId);
      }

      // Atomic Activation Proof (links pending roster NIM + activation hash to UID)
      match /activationClaims/{nimKey} {
        allow get: if isValidId(classId) && isValidNimKey(nimKey)
          && (isClassAdmin(classId) || (isSignedIn() && existing().uid == request.auth.uid));
        allow create: if isValidId(classId) && isValidNimKey(nimKey)
          && isSignedIn()
          && isValidActivationClaim(incoming(), classId, nimKey)
          && incoming().uid == request.auth.uid
          && incoming().claimedAt == request.time
          && request.auth.token.email == (nimKey + '@klik.internal')
          && exists(rosterDocPath(classId, nimKey))
          && get(rosterDocPath(classId, nimKey)).data.status == 'pending'
          && (!('claimedByUid' in get(rosterDocPath(classId, nimKey)).data) || get(rosterDocPath(classId, nimKey)).data.claimedByUid == null)
          && incoming().codeHash == get(rosterDocPath(classId, nimKey)).data.activationCodeHash
          && getAfter(rosterDocPath(classId, nimKey)).data.claimedByUid == request.auth.uid
          && getAfter(memberDocPath(classId, request.auth.uid)).data.nim == get(rosterDocPath(classId, nimKey)).data.nim;
        allow delete: if isValidId(classId) && isValidNimKey(nimKey) && isClassAdmin(classId);
      }

      // Hash-keyed Activation Tickets (get by exact SHA-256 ticketId only, never listable)
      match /activationTickets/{ticketId} {
        allow get: if isValidId(classId) && isValidSha256Hex(ticketId) && isSignedIn();
        allow create: if isValidId(classId) && isValidSha256Hex(ticketId)
          && isClassAdmin(classId)
          && isValidActivationTicket(incoming(), classId, ticketId)
          && incoming().status == 'pending'
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidSha256Hex(ticketId)
          && isValidActivationTicket(incoming(), classId, ticketId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().nim == existing().nim
          && incoming().nimKey == existing().nimKey
          && incoming().updatedAt == request.time
          && (
            isClassAdmin(classId)
            || (
              isSignedIn()
              && existing().status == 'pending'
              && incoming().status == 'active'
              && incoming().name == existing().name
              && incoming().role == existing().role
              && incoming().title == existing().title
              && request.auth.token.email == (existing().nimKey + '@klik.internal')
              && existsAfter(claimDocPath(classId, existing().nimKey))
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
          );
        allow delete: if isValidId(classId) && isValidSha256Hex(ticketId) && isClassAdmin(classId);
      }

      // Class Members & RBAC Roles (No email/PII stored here)
      match /members/{userId} {
        allow get: if isValidId(classId) && isValidId(userId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(userId)
          && isValidClassMember(incoming(), classId, userId)
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && (
            isClassAdmin(classId)
            || (
              isOwner(userId)
              && isClassCreatorAfter(classId)
              && incoming().role == 'admin'
              && incoming().status == 'active'
              && request.auth.token.email == (incoming().nim.lower() + '@klik.internal')
            )
            || (
              isOwner(userId)
              && incoming().status == 'active'
              && request.auth.token.email == (incoming().nim.lower() + '@klik.internal')
              && existsAfter(claimDocPath(classId, incoming().nim.lower()))
              && exists(rosterDocPath(classId, incoming().nim.lower()))
              && incoming().role == get(rosterDocPath(classId, incoming().nim.lower())).data.role
              && incoming().title == get(rosterDocPath(classId, incoming().nim.lower())).data.title
              && incoming().name == get(rosterDocPath(classId, incoming().nim.lower())).data.name
            )
          );
        allow update: if isValidId(classId) && isValidId(userId)
          && isValidClassMember(incoming(), classId, userId)
          && incoming().userId == existing().userId
          && incoming().classId == existing().classId
          && incoming().nim == existing().nim
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && (
            (
              isClassAdmin(classId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarInitials', 'role', 'title', 'status', 'updatedAt'])
            )
            || (
              isOwner(userId)
              && existing().status == 'active'
              && incoming().role == existing().role
              && incoming().title == existing().title
              && incoming().status == existing().status
              && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarInitials', 'updatedAt'])
            )
          );
        allow delete: if isValidId(classId) && isValidId(userId) && isClassAdmin(classId);
      }

      // Courses
      match /courses/{courseId} {
        allow get: if isValidId(classId) && isValidId(courseId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(courseId)
          && isClassAdmin(classId)
          && isValidCourse(incoming(), classId, courseId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidId(courseId)
          && isClassAdmin(classId)
          && isValidCourse(incoming(), classId, courseId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(classId) && isValidId(courseId) && isClassAdmin(classId);
      }

      // Course Collection Links
      match /courseCollections/{courseId} {
        allow get: if isValidId(classId) && isValidId(courseId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(courseId)
          && isClassAdmin(classId)
          && isValidCourseCollection(incoming(), courseId)
          && exists(/databases/$(database)/documents/classes/$(classId)/courses/$(courseId))
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidId(courseId)
          && isClassAdmin(classId)
          && isValidCourseCollection(incoming(), courseId)
          && incoming().courseId == existing().courseId
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(classId) && isValidId(courseId) && isClassAdmin(classId);
      }

      // Schedules
      match /schedules/{scheduleId} {
        allow get: if isValidId(classId) && isValidId(scheduleId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(scheduleId)
          && isClassAdmin(classId)
          && isValidSchedule(incoming(), classId, scheduleId)
          && exists(/databases/$(database)/documents/classes/$(classId)/courses/$(incoming().courseId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidId(scheduleId)
          && isClassAdmin(classId)
          && isValidSchedule(incoming(), classId, scheduleId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(classId) && isValidId(scheduleId) && isClassAdmin(classId);
      }

      // Schedule Exceptions
      match /scheduleExceptions/{exceptionId} {
        allow get: if isValidId(classId) && isValidId(exceptionId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(exceptionId)
          && isClassAdmin(classId)
          && isValidScheduleException(incoming(), classId, exceptionId)
          && exists(/databases/$(database)/documents/classes/$(classId)/schedules/$(incoming().scheduleId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidId(exceptionId)
          && isClassAdmin(classId)
          && isValidScheduleException(incoming(), classId, exceptionId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().scheduleId == existing().scheduleId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(classId) && isValidId(exceptionId) && isClassAdmin(classId);
      }

      // Individual Tasks
      match /individualTasks/{taskId} {
        allow get: if isValidId(classId) && isValidId(taskId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(taskId)
          && isClassAdmin(classId)
          && isValidIndividualTask(incoming(), classId, taskId)
          && incoming().createdBy == request.auth.uid
          && exists(/databases/$(database)/documents/classes/$(classId)/courses/$(incoming().courseId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidId(taskId)
          && isClassAdmin(classId)
          && isValidIndividualTask(incoming(), classId, taskId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().version >= existing().version
          && incoming().diff(existing()).affectedKeys().hasOnly(['courseId', 'title', 'descriptionHtml', 'deadline', 'overrideCollectionLabel', 'overrideCollectionUrl', 'version', 'updatedAt']);
        allow delete: if isValidId(classId) && isValidId(taskId) && isClassAdmin(classId);
      }

      // Personal Task Completions & Notes (strictly per-user!)
      match /taskCompletions/{completionId} {
        allow get: if isValidId(classId)
          && completionId is string && completionId.size() <= 260
          && isClassMember(classId)
          && existing().userId == request.auth.uid;
        allow list: if isValidId(classId)
          && isSignedIn()
          && existing().userId == request.auth.uid;
        allow create: if isValidId(classId)
          && completionId is string && completionId.size() <= 260
          && isClassMember(classId)
          && isValidTaskCompletion(incoming(), classId, completionId)
          && incoming().userId == request.auth.uid
          && exists(/databases/$(database)/documents/classes/$(classId)/individualTasks/$(incoming().taskId))
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId)
          && completionId is string && completionId.size() <= 260
          && isClassMember(classId)
          && isValidTaskCompletion(incoming(), classId, completionId)
          && existing().userId == request.auth.uid
          && incoming().userId == existing().userId
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().taskId == existing().taskId
          && incoming().updatedAt == request.time;
      }

      // Group Activities (totalParticipants & groupCount locked after creation)
      match /groupActivities/{activityId} {
        allow get: if isValidId(classId) && isValidId(activityId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(activityId)
          && isClassAdmin(classId)
          && isValidGroupActivity(incoming(), classId, activityId)
          && incoming().createdBy == request.auth.uid
          && exists(/databases/$(database)/documents/classes/$(classId)/courses/$(incoming().courseId))
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(classId) && isValidId(activityId) && isClassAdmin(classId);
      }

      // Groups
      match /groups/{groupId} {
        allow get: if isValidId(classId) && isValidId(groupId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(groupId)
          && isClassAdmin(classId)
          && isValidGroupItem(incoming(), classId, groupId)
          && incoming().isFinal == false;
        allow update: if isValidId(classId) && isValidId(groupId)
          && isValidGroupItem(incoming(), classId, groupId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().activityId == existing().activityId
          && incoming().groupNumber == existing().groupNumber
          && existing().isFinal == false
          && incoming().isFinal == true
          && incoming().diff(existing()).affectedKeys().hasOnly(['isFinal', 'finalizedAt', 'finalizedBy'])
          && (
            isClassAdmin(classId)
            || (
              isClassMember(classId)
              && exists(/databases/$(database)/documents/classes/$(classId)/groupMembers/$(groupId + '_' + request.auth.uid))
              && incoming().finalizedBy == request.auth.uid
            )
          );
        allow delete: if isValidId(classId) && isValidId(groupId) && isClassAdmin(classId);
      }

      // Group Members (internal doc ID: {groupId}_{userId}; external doc ID: ext_{...})
      match /groupMembers/{memberId} {
        allow get: if isValidId(classId) && memberId is string && memberId.size() <= 260 && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId)
          && memberId is string && memberId.size() <= 260
          && isValidGroupMember(incoming(), classId, memberId)
          && incoming().joinedAt == request.time
          && exists(/databases/$(database)/documents/classes/$(classId)/groups/$(incoming().groupId))
          && get(/databases/$(database)/documents/classes/$(classId)/groups/$(incoming().groupId)).data.isFinal == false
          && (
            isClassAdmin(classId)
            || (
              isClassMember(classId)
              && incoming().isExternal == false
              && incoming().userId == request.auth.uid
              && memberId == (incoming().groupId + '_' + request.auth.uid)
            )
          );
        allow delete: if isValidId(classId)
          && memberId is string && memberId.size() <= 260
          && get(/databases/$(database)/documents/classes/$(classId)/groups/$(existing().groupId)).data.isFinal == false
          && (
            isClassAdmin(classId)
            || (isClassMember(classId) && existing().isExternal == false && existing().userId == request.auth.uid)
          );
      }

      // Group Tasks
      match /groupTasks/{groupTaskId} {
        allow get: if isValidId(classId) && isValidId(groupTaskId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(groupTaskId)
          && isClassAdmin(classId)
          && isValidGroupTask(incoming(), classId, groupTaskId)
          && incoming().createdBy == request.auth.uid
          && exists(/databases/$(database)/documents/classes/$(classId)/groupActivities/$(incoming().activityId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidId(groupTaskId)
          && isClassAdmin(classId)
          && isValidGroupTask(incoming(), classId, groupTaskId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().activityId == existing().activityId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().version >= existing().version
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'descriptionHtml', 'deadline', 'overrideCollectionLabel', 'overrideCollectionUrl', 'version', 'updatedAt']);
        allow delete: if isValidId(classId) && isValidId(groupTaskId) && isClassAdmin(classId);
      }

      // Group Task Completions (per group, writable only by members of that group or class admin)
      match /groupTaskCompletions/{completionId} {
        allow get: if isValidId(classId) && completionId is string && completionId.size() <= 260 && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId)
          && completionId is string && completionId.size() <= 260
          && isValidGroupTaskCompletion(incoming(), classId, completionId)
          && exists(/databases/$(database)/documents/classes/$(classId)/groupTasks/$(incoming().groupTaskId))
          && incoming().updatedAt == request.time
          && (
            isClassAdmin(classId)
            || (
              isClassMember(classId)
              && exists(/databases/$(database)/documents/classes/$(classId)/groupMembers/$(incoming().groupId + '_' + request.auth.uid))
            )
          );
        allow update: if isValidId(classId)
          && completionId is string && completionId.size() <= 260
          && isValidGroupTaskCompletion(incoming(), classId, completionId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().groupTaskId == existing().groupTaskId
          && incoming().groupId == existing().groupId
          && incoming().updatedAt == request.time
          && (
            isClassAdmin(classId)
            || (
              isClassMember(classId)
              && exists(/databases/$(database)/documents/classes/$(classId)/groupMembers/$(existing().groupId + '_' + request.auth.uid))
            )
          );
      }

      // Announcements
      match /announcements/{announcementId} {
        allow get: if isValidId(classId) && isValidId(announcementId) && isClassMember(classId);
        allow list: if isValidId(classId) && isClassMember(classId);
        allow create: if isValidId(classId) && isValidId(announcementId)
          && isClassAdmin(classId)
          && isValidAnnouncement(incoming(), classId, announcementId)
          && incoming().authorId == request.auth.uid
          && incoming().publishedAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(classId) && isValidId(announcementId)
          && isClassAdmin(classId)
          && isValidAnnouncement(incoming(), classId, announcementId)
          && incoming().id == existing().id
          && incoming().classId == existing().classId
          && incoming().authorId == existing().authorId
          && incoming().publishedAt == existing().publishedAt
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(classId) && isValidId(announcementId) && isClassAdmin(classId);
      }

      // Personal Notifications (only readable and mark-read by target user)
      match /notifications/{notificationId} {
        allow get: if isValidId(classId) && isValidId(notificationId)
          && isClassMember(classId)
          && existing().userId == request.auth.uid;
        allow list: if isValidId(classId)
          && isSignedIn()
          && existing().userId == request.auth.uid;
        allow create: if isValidId(classId) && isValidId(notificationId)
          && isClassAdmin(classId)
          && isValidNotification(incoming(), classId, notificationId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(classId) && isValidId(notificationId)
          && isClassMember(classId)
          && existing().userId == request.auth.uid
          && isValidNotification(incoming(), classId, notificationId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if isValidId(classId) && isValidId(notificationId)
          && (isClassAdmin(classId) || (isClassMember(classId) && existing().userId == request.auth.uid));
      }
    }
  }
}
